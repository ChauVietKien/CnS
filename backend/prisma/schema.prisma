//prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    user
    student
    tutor
    admin
}

enum Status {
    pending
    approved
    rejected
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  age       Int?
  role      Role     @default(student)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminProfile   AdminProfile?
  tutorProfile   Tutor_profile?
  studentProfile StudentProfile?
  applications Application[]
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tutor_profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  avatar      String?
  imagebg     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       Tutor_post[]
  evaluations Evaluation[]
}

model Tutor_post {
  id          String       @id @default(uuid())
  subject     String
  Class       String
  description String
  method      String
  price       Int
  address     String?
  field       String
  proof       String
  tutorId     String
  tutor       Tutor_profile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  status      Status       @default(pending)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  schedules    Schedule[]
  evaluations  Evaluation[]
  applications Application[]
}

model Application {
  id        String          @id @default(uuid())
  name      String          
  email     String
  phone     String
  class     String
  note      String?
  postId    String
  post      Tutor_post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  studentId String        
  student   User? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  status    Status          @default(pending)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Evaluation {
  id           String       @id @default(uuid())
  tutorId      String
  tutor        Tutor_profile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutor_postId String
  tutor_post   Tutor_post   @relation(fields: [tutor_postId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Schedule {
  id        String     @id @default(uuid())
  day       String
  startTime String
  endTime   String
  postId    String
  post      Tutor_post @relation(fields: [postId], references: [id], onDelete: Cascade)
}